apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: fb-rds-alerting-platform-<%= env_string %>
  namespace: formbuilder-platform-<%= env_string %>
  labels:
    prometheus: cloud-platform
spec:
  groups:
  - name: platform
    rules:
    - alert: formbuilder-platform-<%= env_string %>-Submitter-RDS-HighCPUUtilization
      expr: aws_rds_cpuutilization_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["dbinstance_identifier"]%>"} > 85
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder Submitter Live Dev - RDS CPU usage > 85%.

    - alert: formbuilder-platform-<%= env_string %>-Submitter-RDS-HighDatabaseConnections
      expr: aws_rds_database_connections_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["dbinstance_identifier"]%>"} > <%=(RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["max_connection"] * 0.75).to_i %>
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder Submitter <%= env_string %> - RDS number of database connections > <%=(RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["max_connection"] * 0.75).to_i %> (max connections <%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["max_connection"] %>).

    - alert: formbuilder-platform-<%= env_string %>-Submitter-RDS-LowStorage
      expr: aws_rds_free_storage_space_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["dbinstance_identifier"]%>"} < 1024*1024*1024
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder Submitter <%= env_string %> - RDS storage capacity < 1GB.

    - alert: formbuilder-platform-<%= env_string %>-Submitter-RDS-Freeable-Memory
      expr: aws_rds_freeable_memory_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["dbinstance_identifier"]%>"} < 500*1024*1024
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder Submitter <%= env_string %> - RDS freeable memory is less than 500MB

    - alert: formbuilder-platform-<%= env_string %>-Submitter-Dev-RDS-HighReadLatency
      expr: aws_rds_read_latency_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["dbinstance_identifier"]%>"} > 0.5
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder Submitter <%= env_string %> - RDS read latency > 500ms.

    - alert: formbuilder-platform-<%= env_string %>-Submitter-RDS-HighWriteLatency
      expr: aws_rds_write_latency_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["submitter"]["rds"]["dbinstance_identifier"]%>"} > 0.5
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder Submitter <%= env_string %> - RDS write latency > 500ms.

    - alert: formbuilder-platform-<%= env_string %>-User-Datastore-RDS-HighCPUUtilization
      expr: aws_rds_cpuutilization_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["dbinstance_identifier"]%>"} > 85
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder User Datastore <%= env_string %> - RDS CPU usage > 85%.

    - alert: formbuilder-platform-<%= env_string %>-User-Datastore-RDS-HighDatabaseConnections
      expr: aws_rds_database_connections_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["dbinstance_identifier"]%>"} > <%=(RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["max_connection"] * 0.75).to_i %>
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder User Datastore <%= env_string %> - RDS number of database connections > <%=(RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["max_connection"] * 0.75).to_i %> (max connections <%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["max_connection"] %>).

    - alert: formbuilder-platform-<%= env_string %>-User-Datastore-RDS-LowStorage
      expr: aws_rds_free_storage_space_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["dbinstance_identifier"]%>"} < 1024*1024*1024
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder User Datastore <%= env_string %> - RDS storage capacity < 1GB.

    - alert: formbuilder-platform-<%= env_string %>-User-Datastore-RDS-Freeable-Memory
      expr: aws_rds_freeable_memory_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["dbinstance_identifier"]%>"} < 500*1024*1024
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder User Datastore <%= env_string %> - RDS freeable memory is less than 500MB

    - alert: formbuilder-platform-<%= env_string %>-User-Datastore-RDS-HighReadLatency
      expr: aws_rds_read_latency_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["dbinstance_identifier"]%>"} > 0.5
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder User Datastore <%= env_string %> - RDS read latency > 500ms.

    - alert: formbuilder-platform-<%= env_string %>-User-Datastore-RDS-HighWriteLatency
      expr: aws_rds_write_latency_average{dbinstance_identifier="<%=RESOURCE_CONFIG["#{destination}-#{env_string}"]["user-datastore"]["rds"]["dbinstance_identifier"]%>"} > 0.5
      for: 1m
      labels:
        severity: <%= severity %>
      annotations:
        message: FormBuilder User Datastore <%= env_string %> - RDS write latency > 500ms.
